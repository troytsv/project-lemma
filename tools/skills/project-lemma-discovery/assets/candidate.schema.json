{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Lemma candidate",
  "type": "object",
  "required": [
    "key",
    "title",
    "statement",
    "field",
    "posed",
    "bounds",
    "unresolved",
    "checked",
    "attempts",
    "formal",
    "strategy",
    "difficulty",
    "verification",
    "significance",
    "leverage",
    "experiment",
    "competition",
    "downside",
    "budget",
    "stop",
    "success",
    "status",
    "lane",
    "sources",
    "aliases",
    "gates",
    "scores"
  ],
  "properties": {
    "key": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "field": {
      "type": "string",
      "minLength": 1
    },
    "posed": {
      "type": "string",
      "minLength": 1
    },
    "bounds": {
      "type": "string",
      "minLength": 1
    },
    "unresolved": {
      "type": "string",
      "minLength": 1
    },
    "checked": {
      "type": "string",
      "minLength": 1,
      "format": "date"
    },
    "attempts": {
      "type": "string",
      "minLength": 1
    },
    "formal": {
      "type": "string",
      "minLength": 1
    },
    "strategy": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "type": "string",
      "minLength": 1
    },
    "verification": {
      "type": "string",
      "minLength": 1
    },
    "significance": {
      "type": "string",
      "minLength": 1
    },
    "leverage": {
      "type": "string",
      "minLength": 1
    },
    "experiment": {
      "type": "string",
      "minLength": 1
    },
    "competition": {
      "type": "string",
      "minLength": 1
    },
    "downside": {
      "type": "string",
      "minLength": 1
    },
    "budget": {
      "type": "string",
      "minLength": 1
    },
    "stop": {
      "type": "string",
      "minLength": 1
    },
    "success": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "screened",
        "deferred",
        "rejected",
        "solved",
        "shortlisted",
        "recommended",
        "attempted"
      ]
    },
    "lane": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "overlooked",
        "ambitious",
        "high-risk"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https?://"
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gates": {
      "type": "object",
      "required": [
        "precision",
        "open",
        "success",
        "verification",
        "resources"
      ],
      "properties": {
        "precision": {
          "type": "boolean"
        },
        "open": {
          "type": "boolean"
        },
        "success": {
          "type": "boolean"
        },
        "verification": {
          "type": "boolean"
        },
        "resources": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "scores": {
      "type": "object",
      "oneOf": [
        {
          "maxProperties": 0
        },
        {
          "required": [
            "tractability",
            "openness",
            "computation",
            "significance",
            "verification",
            "leverage",
            "implications",
            "competition"
          ]
        }
      ],
      "properties": {
        "tractability": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "openness": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "computation": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "significance": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "verification": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "leverage": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "implications": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "competition": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "recommended",
              "shortlisted"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "scores": {
            "minProperties": 8
          },
          "gates": {
            "properties": {
              "precision": {
                "const": true
              },
              "open": {
                "const": true
              },
              "success": {
                "const": true
              },
              "verification": {
                "const": true
              },
              "resources": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
